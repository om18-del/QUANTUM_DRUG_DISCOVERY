# Copy to .env locally. Do not commit .env.

# App
APP_NAME="Quantum Drug Discovery Explorer API"

# Server
HOST=127.0.0.1
PORT=8000

# CORS - comma separated origins, for example:
# CORS_ORIGINS=https://your-frontend.example.com
CORS_ORIGINS=

# Cache
CACHE_DIR=app/data/cache

# Jobs
JOB_STORE_PATH=app/data/jobs.sqlite
